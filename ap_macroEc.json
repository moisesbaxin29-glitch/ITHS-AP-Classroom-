  "units": [
    {
      "unit_id": 1,
      "title": "Basic Economic Concepts",
      "topics": [
        {
          "topic_id": "1.1",
          "name": "Scarcity and Opportunity Cost",
          "notes": [
            "Scarcity means unlimited wants with limited resources.",
            "Opportunity cost is the next best alternative forgone.",
            "Trade-offs exist in all decisions."
          ],
          "formulas": [
            "Opportunity Cost = What is given up / What is gained"
          ],
          "examples": [
            "Choosing college over working = lost wages as opportunity cost"
          ],
          "practice_questions": [
            {
              "question": "What is opportunity cost?",
              "answer": "The next best alternative forgone",
              "explanation": "It measures what you give up when making a choice."
            }
          ],
          "common_mistakes": [
            "Confusing opportunity cost with money cost only"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Scarcity drives all economic decisions",
          "Opportunity cost applies to every choice"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 2,
      "title": "Economic Indicators",
      "topics": [
        {
          "topic_id": "2.1",
          "name": "GDP and Economic Growth",
          "notes": [
            "GDP measures total value of goods and services produced.",
            "Real GDP adjusts for inflation.",
            "Growth rate shows economic expansion."
          ],
          "formulas": [
            "GDP = C + I + G + (X - M)",
            "Real GDP = Nominal GDP / Price Index × 100"
          ],
          "examples": [
            "If GDP increases, economy is expanding"
          ],
          "practice_questions": [
            {
              "question": "What does GDP measure?",
              "answer": "Total output of goods and services",
              "explanation": "It reflects overall economic activity."
            }
          ],
          "common_mistakes": [
            "Confusing GDP with GNP"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "GDP measures production",
          "Real GDP adjusts for inflation"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 3,
      "title": "Inflation and Unemployment",
      "topics": [
        {
          "topic_id": "3.1",
          "name": "Inflation",
          "notes": [
            "Inflation is general rise in price level.",
            "CPI measures inflation.",
            "Demand-pull vs cost-push inflation."
          ],
          "formulas": [
            "Inflation Rate = (CPI2 - CPI1) / CPI1 × 100"
          ],
          "examples": [
            "Higher demand increases inflation"
          ],
          "practice_questions": [
            {
              "question": "What causes demand-pull inflation?",
              "answer": "Increase in aggregate demand",
              "explanation": "Too much spending causes prices to rise."
            }
          ],
          "common_mistakes": [
            "Mixing inflation with price level"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Inflation reduces purchasing power",
          "CPI measures price changes"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 4,
      "title": "Fiscal Policy",
      "topics": [
        {
          "topic_id": "4.1",
          "name": "Government Spending and Taxes",
          "notes": [
            "Fiscal policy uses taxes and spending.",
            "Expansionary = increase spending or cut taxes.",
            "Contractionary = decrease spending or raise taxes."
          ],
          "formulas": [
            "Multiplier = 1 / (1 - MPC)"
          ],
          "examples": [
            "Tax cuts increase consumption"
          ],
          "practice_questions": [
            {
              "question": "What is expansionary fiscal policy?",
              "answer": "Increase government spending or lower taxes",
              "explanation": "Used to boost economy during recession."
            }
          ],
          "common_mistakes": [
            "Confusing fiscal and monetary policy"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Fiscal policy is government action",
          "Affects aggregate demand"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 5,
      "title": "Monetary Policy",
      "topics": [
        {
          "topic_id": "5.1",
          "name": "Federal Reserve Tools",
          "notes": [
            "Fed controls money supply.",
            "Tools: reserve requirement, discount rate, open market operations."
          ],
          "formulas": [
            "Money Multiplier = 1 / reserve requirement"
          ],
          "examples": [
            "Buying bonds increases money supply"
          ],
          "practice_questions": [
            {
              "question": "What happens when Fed buys bonds?",
              "answer": "Money supply increases",
              "explanation": "Injects money into economy."
            }
          ],
          "common_mistakes": [
            "Confusing bond buying with selling"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Fed controls interest rates",
          "Money supply affects inflation"
