      "title": "International Trade",
      "topics": [
        {
          "topic_id": "6.1",
          "name": "Comparative Advantage",
          "notes": [
            "Countries specialize in lowest opportunity cost goods.",
            "Trade increases efficiency."
          ],
          "formulas": [
            "Opportunity Cost comparison determines advantage"
          ],
          "examples": [
            "US produces tech, China produces textiles"
          ],
          "practice_questions": [
            {
              "question": "What is comparative advantage?",
              "answer": "Ability to produce at lower opportunity cost",
              "explanation": "Leads to specialization and trade."
            }
          ],
          "common_mistakes": [
            "Confusing absolute vs comparative advantage"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Trade increases total output",
          "Comparative advantage drives specialization"
