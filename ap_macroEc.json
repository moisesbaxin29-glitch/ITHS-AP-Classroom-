      "topics": [
        {
          "topic_id": "4.1",
          "name": "Government Spending and Taxes",
          "notes": [
            "Fiscal policy uses taxes and spending.",
            "Expansionary increases demand.",
            "Contractionary reduces inflation."
          ],
          "practice_questions": [
            {
              "question": "What is expansionary fiscal policy?",
              "choices": [
                "Increase taxes",
                "Decrease government spending",
                "Increase spending or cut taxes",
                "Raise interest rates"
              ],
              "answer": 2,
              "explanation": "It stimulates economic growth."
            }
          ]
        }
      ]
    },

    {
