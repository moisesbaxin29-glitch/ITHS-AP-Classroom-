      "title": "Monetary Policy",
      "topics": [
        {
          "topic_id": "5.1",
          "name": "Federal Reserve Tools",
          "notes": [
            "Fed controls money supply.",
            "Uses open market operations, reserve ratio, discount rate."
          ],
          "practice_questions": [
            {
              "question": "What happens when the Fed buys bonds?",
              "choices": [
                "Money supply decreases",
                "Money supply increases",
                "Interest rates increase",
                "Taxes increase"
              ],
              "answer": 1,
              "explanation": "Buying bonds injects money into the economy."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 6,
      "title": "International Trade",
      "topics": [
        {
          "topic_id": "6.1",
          "name": "Comparative Advantage",
          "notes": [
            "Countries specialize in lowest opportunity cost goods.",
            "Trade increases efficiency."
          ],
          "practice_questions": [
            {
              "question": "What is comparative advantage?",
              "choices": [
                "Ability to produce more goods overall",
                "Ability to produce at lower opportunity cost",
                "Government trade restriction",
                "High production cost advantage"
              ],
              "answer": 1,
              "explanation": "It means producing at lower opportunity cost."
            }
          ]
        }
