      "unit_id": 1,
      "title": "Basic Economic Concepts",
      "topics": [
        {
          "topic_id": "1.1",
          "name": "Scarcity and Opportunity Cost",
          "notes": [
            "Scarcity means unlimited wants with limited resources.",
            "Opportunity cost is the next best alternative forgone.",
            "Trade-offs exist in all decisions."
          ],
          "practice_questions": [
            {
              "question": "What is opportunity cost?",
              "choices": [
                "Total monetary cost",
                "The next best alternative forgone",
                "Only explicit costs",
                "Government tax rate"
              ],
              "answer": 1,
              "explanation": "It represents the value of the next best alternative you give up."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 2,
      "title": "Economic Indicators",
      "topics": [
        {
          "topic_id": "2.1",
          "name": "GDP and Economic Growth",
          "notes": [
            "GDP measures total value of goods and services produced.",
            "Real GDP adjusts for inflation.",
            "Growth rate shows economic expansion."
          ],
          "practice_questions": [
            {
              "question": "What does GDP measure?",
              "choices": [
                "Government debt only",
                "Total output of goods and services",
                "Inflation rate",
                "Interest rates"
              ],
              "answer": 1,
              "explanation": "GDP measures total economic output."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 3,
      "title": "Inflation and Unemployment",
      "topics": [
        {
          "topic_id": "3.1",
          "name": "Inflation",
          "notes": [
            "Inflation is general rise in price level.",
            "CPI measures inflation.",
            "Demand-pull vs cost-push inflation."
          ],
          "practice_questions": [
            {
              "question": "What causes demand-pull inflation?",
              "choices": [
                "Decrease in taxes",
                "Increase in aggregate demand",
                "Decrease in wages",
                "Lower production costs"
              ],
              "answer": 1,
              "explanation": "Too much demand pushes prices up."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 4,
