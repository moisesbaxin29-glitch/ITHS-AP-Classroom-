{
  "course": "AP Calculus BC",
  "units": [
    {
      "unit_id": 1,
      "title": "Limits and Continuity",
      "topics": [
        {
          "topic_id": "1.1",
          "name": "Understanding Limits",
          "notes": [
            "A limit describes the value a function approaches.",
            "One-sided limits determine behavior from left or right.",
            "Limits may exist even if function is undefined."
          ],
          "practice_questions": [
            {
              "question": "Evaluate lim(x→3) (x^2 - 9)/(x - 3)",
              "choices": [
                "3",
                "6",
                "9",
                "12"
              ],
              "answer": 1,
              "explanation": "Factor: (x-3)(x+3), cancel (x-3), substitute x=3 → 6."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 2,
      "title": "Derivatives",
      "topics": [
        {
          "topic_id": "2.1",
          "name": "Derivative Definition",
          "notes": [
            "Derivative measures instantaneous rate of change.",
            "It represents slope of a tangent line."
          ],
          "practice_questions": [
            {
              "question": "Find derivative of f(x)=x^3",
              "choices": [
                "x^2",
                "2x^2",
                "3x^2",
                "3x^3"
              ],
              "answer": 2,
              "explanation": "Power rule: d/dx(x^n)=nx^(n-1)"
            }
          ]
        }
      ]
    },

    {
      "unit_id": 3,
      "title": "Integrals",
      "topics": [
        {
          "topic_id": "3.1",
          "name": "Fundamental Theorem of Calculus",
          "notes": [
            "Connects derivatives and integrals.",
            "Used to compute area under curves."
          ],
          "practice_questions": [
            {
              "question": "Find ∫ 3x^2 dx",
              "choices": [
                "x^3",
                "x^3 + C",
                "3x^3 + C",
                "x^2 + C"
              ],
              "answer": 1,
              "explanation": "Power rule: increase exponent, divide, add +C"
            }
          ]
        }
      ]
    },

    {
      "unit_id": 4,
      "title": "Series and Sequences",
      "topics": [
        {
          "topic_id": "4.1",
          "name": "Convergence Tests",
          "notes": [
            "Used to determine if infinite series converge.",
            "Includes ratio, comparison, and integral tests."
          ],
          "practice_questions": [
            {
              "question": "Does Σ 1/2^n converge?",
              "choices": [
                "No",
                "Yes",
                "Only sometimes",
                "Cannot determine"
              ],
              "answer": 1,
              "explanation": "Geometric series with r < 1 converges."
            }
          ]
        }
      ]
    },

    {
      "unit_id": 5,
      "title": "Parametric, Polar, and Vector Functions",
      "topics": [
        {
          "topic_id": "5.1",
          "name": "Parametric Equations",
          "notes": [
            "Equations defined in terms of parameter t.",
            "Used to describe motion in space."
          ],
          "practice_questions": [
            {
              "question": "Find dy/dx if x=t and y=t^2",
              "choices": [
                "t",
                "2t",
                "t^2",
                "1/t"
              ],
              "answer": 1,
              "explanation": "dy/dx = (dy/dt)/(dx/dt) = (2t)/1 = 2t"
            }
          ]
        }
      ]
    }
  ]
}