  "units": [
    {
      "unit_id": 1,
      "title": "Limits and Continuity",
      "topics": [
        {
          "topic_id": "1.1",
          "name": "Understanding Limits",
          "notes": [
            "A limit describes the value a function approaches.",
            "One-sided limits determine behavior from left or right.",
            "Limits may exist even if function is undefined."
          ],
          "formulas": [
            "lim(x→a) f(x) = L",
            "lim(x→∞) f(x)"
          ],
          "examples": [
            "lim(x→2) (x^2 - 4)/(x - 2) = 4"
          ],
          "practice_questions": [
            {
              "question": "Evaluate lim(x→3) (x^2 - 9)/(x - 3)",
              "answer": "6",
              "explanation": "Factor numerator: (x-3)(x+3), cancel, substitute x=3."
            }
          ],
          "common_mistakes": [
            "Forgetting to factor before substituting"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Limits define behavior near points",
          "Continuity requires limit equals function value"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 2,
      "title": "Derivatives",
      "topics": [
        {
          "topic_id": "2.1",
          "name": "Derivative Definition",
          "notes": [
            "Derivative measures instantaneous rate of change",
            "Slope of tangent line"
          ],
          "formulas": [
            "f'(x) = lim(h→0) (f(x+h) - f(x))/h"
          ],
          "examples": [
            "Derivative of x^2 is 2x"
          ],
          "practice_questions": [
            {
              "question": "Find derivative of f(x)=x^3",
              "answer": "3x^2",
              "explanation": "Power rule: nx^(n-1)"
            }
          ],
          "common_mistakes": [
            "Forgetting to subtract 1 from exponent"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Derivatives represent rate of change",
          "Use power, product, quotient, chain rules"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 3,
      "title": "Integrals",
      "topics": [
        {
          "topic_id": "3.1",
          "name": "Fundamental Theorem of Calculus",
          "notes": [
            "Connects derivatives and integrals",
            "Area under curve"
          ],
          "formulas": [
            "∫ f(x) dx = F(x) + C",
            "d/dx ∫ f(t) dt = f(x)"
          ],
          "examples": [
            "∫ 2x dx = x^2 + C"
          ],
          "practice_questions": [
            {
              "question": "Find ∫ 3x^2 dx",
              "answer": "x^3 + C",
              "explanation": "Increase exponent and divide"
            }
          ],
          "common_mistakes": [
            "Forgetting +C"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Integration is reverse of differentiation",
          "Used for area and accumulation"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 4,
      "title": "Series and Sequences",
      "topics": [
        {
          "topic_id": "4.1",
          "name": "Convergence Tests",
          "notes": [
            "Determine if infinite series converges",
            "Common tests: ratio, comparison, integral"
          ],
          "formulas": [
            "Σ a_n",
            "lim n→∞ a_n = 0 (necessary condition)"
          ],
          "examples": [
            "Geometric series: a/(1-r)"
          ],
          "practice_questions": [
            {
              "question": "Does Σ 1/2^n converge?",
              "answer": "Yes",
              "explanation": "Geometric series with r<1"
            }
          ],
          "common_mistakes": [
            "Confusing divergence with divergence test failure"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Series may converge or diverge",
          "Geometric and p-series are key types"
        ],
        "practice_test": [],
        "flashcards": []
      }
    },

    {
      "unit_id": 5,
      "title": "Parametric, Polar, and Vector Functions",
      "topics": [
        {
          "topic_id": "5.1",
          "name": "Parametric Equations",
          "notes": [
            "Functions defined by parameter t",
            "Used for motion"
          ],
          "formulas": [
            "dx/dt, dy/dt",
            "dy/dx = (dy/dt)/(dx/dt)"
          ],
          "examples": [
            "x=t, y=t^2 → parabola"
          ],
          "practice_questions": [
            {
              "question": "Find dy/dx if x=t, y=t^2",
              "answer": "2t",
              "explanation": "Divide derivatives"
            }
          ],
          "common_mistakes": [
            "Forgetting chain rule in parametrics"
          ]
        }
      ],
      "unit_review": {
        "key_concepts": [
          "Parametric = motion",
          "Polar = angle-based system",
          "Vectors = direction + magnitude"
        ],
